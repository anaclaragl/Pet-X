{
  "expo": {
    "name": "Pet-X",
    "slug": "Pet-X",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anaclara.petx",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Pet-X utiliza sua localização para exibir pets e alertas próximos a você.",
        "NSCameraUsageDescription": "O Pet-X precisa de acesso à câmera para fotografar os pets para publicação.",
        "NSPhotoLibraryUsageDescription": "O Pet-X precisa de acesso às suas fotos para publicar imagens dos pets."
      }
    },
    "android": {
      "package": "com.anaclara.petx",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Pet-X precisa da sua localização para encontrar pets próximos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Pet-X precisa de acesso às suas fotos para publicar pets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

